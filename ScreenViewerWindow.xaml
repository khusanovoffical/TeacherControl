<Window x:Class="TeacherControl.ScreenViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masofaviy ko‘rish va boshqaruv"
        Height="800" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#080D1A" Foreground="#F4F6FF"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1E3A8A">
                        <TextBlock Text="🖥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock x:Name="DeviceTitleText" Text="PC-01 · Alisher Navoiy" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="DeviceSubtitleText" Text="Device ID: ... · Jonli ekran sessiyasi" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Tugmalari -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Remote Control Toggle -->
                    <ToggleButton x:Name="RemoteControlToggle" Content="Masofaviy boshqaruv (OFF)" Padding="14,8"
                                  Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155"
                                  Checked="RemoteControlToggle_Checked" Unchecked="RemoteControlToggle_Unchecked"
                                  Cursor="Hand" Margin="0,0,10,0"/>

                    <Button Content="Qulflash" Padding="12,8" Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0"
                            Margin="0,0,8,0" Cursor="Hand" Click="Lock_Click"/>

                    <Button Content="Ochish" Padding="12,8" Background="#064E3B" Foreground="#6EE7B7" BorderThickness="0"
                            Margin="0,0,14,0" Cursor="Hand" Click="Unlock_Click"/>

                    <Button Content="Fullscreen" Padding="12,8" Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155"
                            Margin="0,0,8,0" Cursor="Hand" Click="Fullscreen_Click"/>

                    <Button Content="Yopish" Padding="14,8" Background="#2563EB" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Jonli Ekran Tasviri -->
        <Grid Grid.Row="1" Background="#020617">
            <Image x:Name="ScreenImage" Stretch="Uniform"
                   MouseMove="ScreenImage_MouseMove"
                   MouseDown="ScreenImage_MouseDown"
                   MouseUp="ScreenImage_MouseUp"/>

            <!-- Bo'sh yoki kutish holati -->
            <StackPanel x:Name="LoadingOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="▣" FontSize="48" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                <TextBlock Text="O‘quvchi ekrani kutilmoqda..." FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="O‘quvchi kompyuterida dars sessiyasi faol bo‘lishi kerak." Foreground="#64748B" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
